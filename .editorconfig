# Shared editor settings. Keeps contributions consistent without a formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Trailing whitespace is meaningful in Markdown line breaks.
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab
